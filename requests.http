# Requests for a local API with demo data (`npm run db:seed`).
# Open in VS Code (REST Client extension) or a JetBrains IDE (HTTP Client).

@baseUrl = http://localhost:3000

### Readiness: 200 once the database is reachable and migrated
GET {{baseUrl}}/health/ready

### Service types
GET {{baseUrl}}/v1/service-types

@dealershipId = 01a16194-0000-7000-8000-000000000001

### Technicians of a dealership, with their skills
GET {{baseUrl}}/v1/dealerships/{{dealershipId}}/technicians

### Service bays of a dealership
GET {{baseUrl}}/v1/dealerships/{{dealershipId}}/bays

# Oil service. Shifts are seeded for the next 30 days: pick a date in that range.
@serviceTypeId = 01a16194-0000-7000-8000-0000000000a2
@date = 2026-11-03

### Bookable start times on one day, with free technician and bay counts
GET {{baseUrl}}/v1/dealerships/{{dealershipId}}/availability?serviceTypeId={{serviceTypeId}}&date={{date}}

# The demo seed has one past, completed appointment.
@appointmentId = 01a16194-0000-7000-8000-0000000000d1

### One appointment
GET {{baseUrl}}/v1/appointments/{{appointmentId}}
