NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler
# Optional: a DDL-capable role for `npm run db:migrate`; defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgres://scheduler_owner:...@localhost:5432/scheduler
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

SWAGGER_ENABLED=true
# CORS_ALLOWED_ORIGINS=http://localhost:5173
PROBLEM_TYPE_BASE_URL=https://scheduler.example.com/problems
SHUTDOWN_GRACE_PERIOD_MS=5000

# Bookable starts lie on this grid (a divisor of 60), aligned to local midnight in the dealership's zone.
BOOKING_SLOT_GRID_MINUTES=15
BOOKING_MIN_LEAD_MINUTES=30
BOOKING_HORIZON_DAYS=90
# How long a booking waits behind a competing in-flight booking before answering 503 (100-10000).
BOOKING_LOCK_TIMEOUT_MS=2000
# Insert attempts per booking when another request takes the chosen technician or bay first (1-10).
BOOKING_MAX_ATTEMPTS=3
# A 409 SLOT_UNAVAILABLE suggests up to this many later start times (0-10), searching this many local days (1-31).
BOOKING_ALTERNATIVES=3
BOOKING_ALTERNATIVES_SEARCH_DAYS=7

OTEL_SERVICE_NAME=service-scheduler
# Leave unset to disable trace and metric export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
